menu "Example Configuration"

    menu "Ingest Server"

        choice EXAMPLE_SERVER_TYPE
            prompt "Ingest server type"
            default EXAMPLE_SERVER_TYPE_MATTER
            help
                Both backends implement DASH-IF Live Media Ingest Interface-2.

                  Matter  – Matter push_av_server (HTTPS, mTLS optional).
                            Start: python push_av_server/server.py --working-directory ~/.pavstest
                            Default port: 1234

                  Nagare  – nagare-media/ingest (plain HTTP, no certs needed).
                            Start: docker compose up nagare  (from docker/ directory)
                            Default port: 8080
                            https://github.com/nagare-media/ingest

            config EXAMPLE_SERVER_TYPE_MATTER
                bool "Matter push_av_server (HTTPS)"

            config EXAMPLE_SERVER_TYPE_NAGARE
                bool "nagare-media/ingest (plain HTTP)"

        endchoice

        config EXAMPLE_SERVER_HOST
            string "Server hostname or IP address"
            default "192.168.1.100"
            help
                LAN IP (or hostname) of the machine running the ingest server.

        config EXAMPLE_NAGARE_USE_TLS
            bool "Enable TLS for nagare server (via nginx proxy)"
            depends on EXAMPLE_SERVER_TYPE_NAGARE
            default n
            help
                Connect to nagare via HTTPS instead of plain HTTP.

                Requires a running nginx TLS proxy in front of nagare.
                Start it with:  docker compose --profile tls up

                Steps to set up:
                  1. cd docker/certs && ./gen_cert.sh <LAN_IP>
                  2. cp docker/certs/server.crt main/certs/nagare_server_ca.pem
                  3. docker compose --profile tls up
                  4. Enable this option and set port to 8443.

        config EXAMPLE_SERVER_PORT
            int "Server port"
            default 8443 if EXAMPLE_SERVER_TYPE_NAGARE && EXAMPLE_NAGARE_USE_TLS
            default 8080 if EXAMPLE_SERVER_TYPE_NAGARE
            default 1234
            range 1 65535
            help
                Port the ingest server is listening on.
                  Matter default      : 1234 (HTTPS)
                  Nagare plain HTTP   : 8080
                  Nagare with TLS     : 8443 (nginx proxy)

        config EXAMPLE_TRACK_NAME
            string "CMAF track name"
            default "video1"
            help
                Name for the H.264 video track.
                Also used as the nagare stream name (with ".str" appended).

                Used in ingest / playback URLs:
                  PUT /dash/<track>.str/<track>/<track>.init
                  PUT /dash/<track>.str/<track>/segment_NNNN.m4s
                  GET /dash/<track>.str/manifest.mpd   (DASH playback)
                  GET /dash/<track>.str/master.m3u8    (HLS playback, if enabled)

        config EXAMPLE_ENABLE_HLS
            bool "Also generate HLS playlist (alongside DASH MPD)"
            depends on EXAMPLE_SERVER_TYPE_NAGARE || EXAMPLE_SERVER_TYPE_MATTER
            default n
            help
                Generates HLS master + media playlists in addition to the DASH MPD.
                The same fMP4 segments are reused for both protocols, so no extra
                data is uploaded to the server.

                For nagare-media/ingest:
                  master.m3u8   – http://{host}:{port}/dash/{track}_{ts}.str/master.m3u8
                  playlist.m3u8 – …/{track}/playlist.m3u8  (updated after every segment)
                  Play: ffplay "http://<HOST>:8080/dash/<track>_<ts>.str/master.m3u8"

                For Matter push_av_server:
                  master.m3u8   – https://{host}:{port}/streams/{id}/session_{N}/master.m3u8
                  playlist.m3u8 – …/{track}/playlist.m3u8  (updated after every segment)
                  Play: ffplay "https://<HOST>:1234/streams/<id>/session_1/master.m3u8"

    endmenu

    menu "TLS / mTLS (Matter only)"

        config EXAMPLE_USE_MTLS
            bool "Enable mutual TLS (client certificate)"
            depends on EXAMPLE_SERVER_TYPE_MATTER
            default n
            help
                Embed PEM files from main/certs/ and present a client certificate
                to the Matter push_av_server.  Not used for nagare-media/ingest.

                Files required (copy before building):
                  main/certs/server_root_ca.pem  – server CA certificate
                  main/certs/client_cert.pem      – device certificate
                  main/certs/client_key.pem        – device private key

                Generate with:
                  curl -k -XPOST https://<PC_IP>:1234/certs/esp32/keypair

                When disabled, TLS is used but without client certificate
                (push_av_server must be started with --no-strict).

    endmenu

    menu "Stream Settings"

        config EXAMPLE_FRAMES_PER_SEGMENT
            int "Frames per CMAF segment"
            default 30
            range 5 128
            help
                Number of H.264 frames to accumulate before flushing one
                CMAF media segment and uploading it.

                At 30 fps:
                  30  frames → ~1 second per segment  (recommended)
                  60  frames → ~2 seconds per segment
                  15  frames → ~0.5 seconds per segment (more overhead)

        config EXAMPLE_STREAM_DURATION_SEC
            int "Stream duration in seconds (0 = run forever)"
            default 0
            range 0 86400
            help
                Stop streaming after this many seconds.
                Set to 0 for continuous operation until reset.

        choice EXAMPLE_SEGMENT_NAMING
            prompt "Segment naming mode"
            default EXAMPLE_SEGMENT_NAMING_NUMBER
            help
                Choose how segment filenames are generated:
                - Number-based: Uses segment_<number>.m4s (Matter spec compliant for recordings)
                - Timestamp-based: Uses segment_<timestamp>.m4s (better for live streams)

            config EXAMPLE_SEGMENT_NAMING_NUMBER
                bool "Number-based (Recording/Static)"
                help
                    Use sequential segment numbers (segment_1001.m4s, segment_1002.m4s, ...)
                    Compliant with Matter PushAV spec for recordings/static streams.
                    MPD uses $Number$ template.

            config EXAMPLE_SEGMENT_NAMING_TIMESTAMP
                bool "Timestamp-based (Live/Dynamic)"
                help
                    Use presentation timestamps (segment_<timestamp>.m4s)
                    Better for live/dynamic streams as it matches player requests.
                    MPD uses $Time$ template.

        endchoice

    endmenu

    menu "H.264 Encoder"

        config EXAMPLE_H264_I_PERIOD
            int "I-frame period (frames between keyframes)"
            default 30
            range 1 120
            help
                Keyframe interval.  Should be <= FRAMES_PER_SEGMENT so that
                every CMAF segment starts with an IDR frame, enabling random
                access and DASH seeking.

        config EXAMPLE_H264_BITRATE
            int "Target bitrate (bps)"
            default 1000000
            range 25000 4000000
            help
                H.264 target bitrate in bits per second.
                At 1 Mbps a 1-second CMAF segment is approximately 125 KB,
                which easily fits within the ESP32-P4 PSRAM budget.

        config EXAMPLE_H264_MIN_QP
            int "Minimum QP (best quality ceiling)"
            default 25
            range 1 51

        config EXAMPLE_H264_MAX_QP
            int "Maximum QP (worst quality floor)"
            default 26
            range 1 51

    endmenu

endmenu
